LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0

SANDBOX_ROOT=.sandbox
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MAX_OUTPUT_BYTES=262144

CHECKPOINT_DB=.data/checkpoints.sqlite

SKILLS_DIR=skills
MCP_CONFIG=config/mcp.servers.json
A2A_PEERS=config/a2a.peers.json

A2A_PORT=4124
A2A_PUBLIC_URL=http://localhost:4124
A2A_AGENT_NAME=muliuniuma
A2A_DESCRIPTION=可扩展的 TypeScript Agent 运行时

# 上下文压缩：历史超过 SUMMARY_TRIGGER_TOKENS 时自动摘要，保留最近约 SUMMARY_KEEP_TOKENS 的原文
SUMMARY_ENABLED=true
SUMMARY_TRIGGER_TOKENS=8000
SUMMARY_KEEP_TOKENS=2000
SUMMARY_TRIM_TOKENS=8000

# 工具加载分档：按可延迟工具条数与 schema token 选全量 / 目录 / 检索，目录与检索档用 activate_tools 按需激活
TOOL_LOADING_ENABLED=true
TOOL_LOADING_EAGER_MAX_TOOLS=12
TOOL_LOADING_EAGER_MAX_TOKENS=1500
TOOL_LOADING_CATALOG_MAX_TOOLS=40
TOOL_LOADING_CATALOG_MAX_TOKENS=4000
TOOL_LOADING_SEARCH_TOP_K=8
TOOL_LOADING_MAX_ACTIVE=24

# 工具输出清理：视图 token 达到触发阈值时把旧工具输出换成占位符，保留最近几条，checkpoint 原文不动
TOOL_CLEARING_ENABLED=true
TOOL_CLEARING_TRIGGER_TOKENS=6000
TOOL_CLEARING_KEEP_MESSAGES=3

LOG_LEVEL=info
