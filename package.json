{
  "name": "muliuniuma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extensible TypeScript agent runtime: LLM, MCP, Skills, Sandbox, A2A",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/check-node.ts && tsx src/cli.ts",
    "serve": "tsx scripts/check-node.ts && tsx src/serve.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint": "^1.2.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.1",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/openai": "^1.8.4",
    "express": "^5.3.0",
    "langchain": "^1.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
